{
  "name": "@opdsh/unity-plugin",
  "version": "0.1.4",
  "description": "DeepSeek Harness plugin: control the Unity Editor through the unity CLI — project management, live-editor pipeline commands, and C# eval as agent tools.",
  "author": "vibotaku <vibotaku@vbytes.mozmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opdsh/unity-plugin.git"
  },
  "homepage": "https://github.com/opdsh/unity-plugin#readme",
  "bugs": {
    "url": "https://github.com/opdsh/unity-plugin/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "import": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "files": [
    "README.zh.md",
    "lib",
    "assets",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dsh-plugin",
    "unity",
    "deepseek-harness",
    "cordis"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 || >=4.0.3-0",
    "@deepseek-ai/dsh-settings": ">=0.1.2-alpha.5 || >=0.2.0-0",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.1.2-alpha.5 || >=0.2.0-0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.2-alpha.5 || >=0.2.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.5 || >=0.2.0-0",
    "@deepseek-ai/schemastery": ">=3.18.2 || >=3.18.3-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-subprocess": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.5",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.0"
  }
}
